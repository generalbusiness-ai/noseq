{
  "name": "noseq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.1",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check": "node scripts/check-toolchain.ts && node -e \"require('node:fs').mkdirSync('.generated', {recursive:true})\" && wrangler types --env-interface WorkerEnv .generated/worker-configuration.d.ts && tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.webworker.json && tsc -p tsconfig.crypto-preflight.json",
    "build": "node scripts/check-toolchain.ts && vite build && wrangler deploy --dry-run --outdir dist/worker",
    "dev": "vite --host 127.0.0.1",
    "browser:install": "playwright install chromium",
    "test:harness": "node scripts/run-harness.ts",
    "verify:evidence": "node scripts/verify-evidence.ts",
    "test:crypto-feasibility": "node scripts/protocol-gates.ts test:crypto-feasibility",
    "gate:protocol": "node scripts/protocol-gates.ts gate:protocol",
    "test:protocol": "node scripts/not-implemented.ts test:protocol",
    "test:runtime": "node scripts/not-implemented.ts test:runtime",
    "test:definition": "node scripts/not-implemented.ts test:definition",
    "test:workers": "node scripts/not-implemented.ts test:workers",
    "test:relay": "node scripts/not-implemented.ts test:relay",
    "test:mirror": "node scripts/not-implemented.ts test:mirror",
    "test:client": "node scripts/not-implemented.ts test:client",
    "test:recovery": "node scripts/not-implemented.ts test:recovery",
    "test:ui": "node scripts/not-implemented.ts test:ui",
    "test:dynamic-apps": "node scripts/not-implemented.ts test:dynamic-apps",
    "test:flows": "node scripts/not-implemented.ts test:flows",
    "acceptance": "node scripts/not-implemented.ts acceptance",
    "benchmark": "node scripts/not-implemented.ts benchmark",
    "probe:crypto-preflight": "node scripts/crypto-preflight.ts",
    "verify:crypto-preflight": "node scripts/crypto-preflight.ts --verify",
    "probe:ordered-mls": "node scripts/ordered-mls.ts",
    "verify:ordered-mls": "node scripts/ordered-mls.ts --verify",
    "probe:protocol-feasibility": "node scripts/protocol-feasibility.ts",
    "verify:protocol-feasibility": "node scripts/protocol-feasibility.ts --verify",
    "probe:segmented-recovery": "node scripts/segmented-recovery.ts",
    "verify:segmented-recovery": "node scripts/segmented-recovery.ts --verify",
    "probe:protocol-closure": "node scripts/protocol-closure.ts",
    "verify:protocol-closure": "node scripts/protocol-closure.ts --verify",
    "build:decision-verifier": "node scripts/decision-verifier-build.ts",
    "verify:decision": "node scripts/decision-verify.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@noble/curves": "2.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "nostr-tools": "2.25.2",
    "pnpm": "10.34.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0",
    "ws": "8.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
